#!/bin/bash
# Starts My Annual Review from the folder this app sits in (the my_annual_review folder).
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ ! -f "$APP_DIR/server.py" ]; then
  /usr/bin/osascript -e 'display dialog "Annual Review needs to stay inside the my_annual_review folder, next to server.py.\n\nTo put it on your Desktop or Dock, right-click the app and choose Make Alias, or drag it to the Dock." buttons {"OK"} default button 1 with icon caution'
  exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display dialog "Python 3 was not found on this Mac. Install it from python.org/downloads and open Annual Review again." buttons {"OK"} default button 1 with icon caution'
  exit 1
fi
exec /usr/bin/open -a Terminal "$APP_DIR/start.command"
